# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
JWT_SIGNING_KEY=
ASPNETCORE_ENVIRONMENT=Development
# Optional BR-ACCESS-006 overrides (defaults: 50 MiB/file, 20 models, 1 GiB/customer)
MODEL_UPLOAD_MAX_FILE_BYTES=52428800
MODEL_UPLOAD_MAX_MODELS=20
MODEL_UPLOAD_MAX_STORAGE_BYTES=1073741824
