# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
JWT_SIGNING_KEY=
ASPNETCORE_ENVIRONMENT=Development
APP_FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
# Gmail requires 2-Step Verification and a dedicated App Password (never your normal password).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=printgridproduction@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=printgridproduction@gmail.com
SMTP_FROM_NAME=PrintGrid
# Optional BR-ACCESS-006 overrides (defaults: 50 MiB/file, 20 models, 1 GiB/customer)
MODEL_UPLOAD_MAX_FILE_BYTES=52428800
MODEL_UPLOAD_MAX_MODELS=20
MODEL_UPLOAD_MAX_STORAGE_BYTES=1073741824
