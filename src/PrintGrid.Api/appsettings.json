{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=printgrid_db;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "PrintGrid",
    "Audience": "PrintGrid.Client",
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "App": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Email": {
    "Smtp": {
      "Enabled": false,
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromEmail": "",
      "FromName": "PrintGrid"
    }
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": "",
    "UseSsl": false,
    "ModelBucket": "printgrid-models",
    "SliceBucket": "printgrid-slices",
    "PhotoBucket": "printgrid-photos"
  },
  "ModelUpload": {
    "MaxFileBytes": 52428800,
    "MaxModelsPerCustomer": 20,
    "MaxStorageBytesPerCustomer": 1073741824
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "Scheduling": {
    "QuoteValidityHours": 24,
    "InternalDueDateBufferDays": 2,
    "MaxReassignmentAttempts": 3,
    "Weights": {
      "DueDateSlack": 0.35,
      "LabReliability": 0.25,
      "LoadBalance": 0.20,
      "Cost": 0.10,
      "Transit": 0.10
    }
  },
  "Payment": {
    "DepositPercent": 50
  },
  "QuoteReview": {
    "AutoLaneThreshold": 300000,
    "AdjustmentBandPercent": 10,
    "ValidityHours": 48,
    "QueueSlaHours": 2
  },
  "ShipmentBatch": {
    "ZoneRates": {
      "LOCAL": 50000,
      "NEAR": 80000,
      "REMOTE": 120000
    },
    "WeightMultipliers": {
      "UpTo5Kg": 1.6,
      "Over5Kg": 2.4
    }
  },
  "OpsMonitor": {
    "AtRiskSlackHours": 4,
    "RefreshSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/printgrid-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
